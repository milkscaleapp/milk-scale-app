{
  "splash": {
    "enabled": true,
    "type": "animation",
    "backgroundColor": "#2e7d32",
    "duration": 2000,
    "animation": {
      "name": "logo_burst_zoom",
      "loop": false,
      "fillMode": "forwards",
      "keyframes": [
        {
          "offset": 0,
          "transform": "scale(0.1)",
          "opacity": 0
        },
        {
          "offset": 0.4,
          "transform": "scale(0.1)",
          "opacity": 1
        },
        {
          "offset": 0.7,
          "transform": "scale(1.25)",
          "opacity": 1
        },
        {
          "offset": 0.85,
          "transform": "scale(0.95)",
          "opacity": 1
        },
        {
          "offset": 1,
          "transform": "scale(1)",
          "opacity": 1
        }
      ]
    },
    "logo": {
      "src": "images/milk-scale-app-logo.png",
      "width": "180px",
      "height": "180px",
      "position": "center",
      "fit": "contain"
    },
    "loader": {
      "enabled": false
    },
    "statusBarColor": "#1b5e20",
    "fullscreen": true
  }
}