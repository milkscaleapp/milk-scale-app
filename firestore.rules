rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  match /profiles/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','email','role','createdAt'])
    && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
    && request.resource.data.role in ['owner','customer'] && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
  match /invitations/{code} {
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['ownerUid','customerPhone','customerName','status','createdAt','expiresAt'])
    && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending'
    && request.resource.data.customerPhone is string && request.resource.data.customerPhone.matches('^[0-9+ -]{8,20}$')
    && request.resource.data.customerName is string && request.resource.data.createdAt == request.time
    && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
    && request.resource.data.expiresAt < request.time + duration.value(8,'d');
   allow get: if signedIn();
   allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
   allow update: if signedIn() && resource.data.status == 'pending'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','customerUid','respondedAt'])
    && request.resource.data.status in ['accepted','rejected']
    && request.resource.data.customerUid == request.auth.uid && request.resource.data.respondedAt == request.time;
   allow delete: if false;
  }
  match /connections/{id} {
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid','customerUid','invitationCode','status','createdAt'])
    && request.resource.data.customerUid == request.auth.uid && request.resource.data.status == 'active'
    && request.resource.data.createdAt == request.time
    && existsAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode))
    && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.ownerUid == request.resource.data.ownerUid
    && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.customerUid == request.auth.uid
    && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationCode)).data.status == 'accepted';
   allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.customerUid == request.auth.uid);
   allow update, delete: if false;
  }
 }
}