rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() {
   return request.auth != null && request.auth.token.email_verified == true;
  }
  function ownerProfile() {
   return signedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'owner';
  }

  match /userIds/{dairyId} {
   // IDs are reserved once, by the account that receives them. Read access is needed for collision checks.
   allow get: if request.auth != null;
   allow list: if false;
   allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['uid','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && dairyId.matches('^[a-z]{6}$')
    && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }

  match /profiles/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   // Signup profile and unique ID reservation are committed in the same transaction.
   allow create: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','email','displayName','dairyId','role','createdAt','avatarData'])
    && request.resource.data.uid == uid
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.role == 'customer'
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() >= 2
    && request.resource.data.dairyId is string
    && request.resource.data.dairyId.matches('^[a-z]{6}$')
    && existsAfter(/databases/$(database)/documents/userIds/$(request.resource.data.dairyId))
    && getAfter(/databases/$(database)/documents/userIds/$(request.resource.data.dairyId)).data.uid == uid
    && request.resource.data.createdAt == request.time;
   allow update: if signedIn() && request.auth.uid == uid
    && request.resource.data.uid == resource.data.uid
    && request.resource.data.email == resource.data.email
    && request.resource.data.role in ['owner','customer']
    && !('username' in request.resource.data)
    && request.resource.data.dairyId is string
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','role','avatarData','dairyId','username'])
    && (
      (('dairyId' in resource.data) && request.resource.data.dairyId == resource.data.dairyId)
      ||
      (!('dairyId' in resource.data)
       && request.resource.data.dairyId.matches('^[a-z]{6}$')
       && existsAfter(/databases/$(database)/documents/userIds/$(request.resource.data.dairyId))
       && getAfter(/databases/$(database)/documents/userIds/$(request.resource.data.dairyId)).data.uid == uid)
    )
    && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2))
    && (!('avatarData' in request.resource.data) || (request.resource.data.avatarData is string && request.resource.data.avatarData.size() < 450000));
   allow delete: if false;
  }
  match /dairyDirectory/{dairyId} {
   allow get: if signedIn();
   allow list: if signedIn();
   allow create: if signedIn()
    && request.resource.data.ownerUid == request.auth.uid
    && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'owner'
    && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.dairyId == dairyId
    && request.resource.data.dairyId == dairyId
    && request.resource.data.keys().hasOnly(['ownerUid','displayName','dairyId','createdAt','avatarData','active']);
   allow update: if signedIn()
    && resource.data.ownerUid == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarData','active','displayName','username'])
    && !('username' in request.resource.data)
    && (!('avatarData' in request.resource.data) || (request.resource.data.avatarData is string && request.resource.data.avatarData.size() < 450000))
    && (!('active' in request.resource.data) || request.resource.data.active is bool)
    && (!('displayName' in request.resource.data) || request.resource.data.displayName is string);
   allow delete: if false;
  }

  match /connectionRequests/{requestId} {
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['requesterUid','requesterEmail','requesterRole','requesterName','targetUid','targetName','targetDairyId','status','createdAt'])
    && request.resource.data.requesterUid == request.auth.uid
    && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'customer'
    && request.resource.data.requesterRole == 'customer'
    && get(/databases/$(database)/documents/profiles/$(request.resource.data.targetUid)).data.role == 'owner'
    && exists(/databases/$(database)/documents/dairyDirectory/$(request.resource.data.targetDairyId))
    && get(/databases/$(database)/documents/dairyDirectory/$(request.resource.data.targetDairyId)).data.ownerUid == request.resource.data.targetUid
    && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time;
   allow get: if signedIn() && (resource.data.requesterUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
   allow list: if signedIn() && (resource.data.requesterUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
   allow update: if signedIn()
    && resource.data.status == 'pending'
    && resource.data.targetUid == request.auth.uid
    && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'owner'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
    && request.resource.data.status in ['accepted','rejected']
    && request.resource.data.respondedAt == request.time;
   allow delete: if false;
  }

  match /connections/{id} {
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['ownerUid','customerUid','customerName','requestId','status','createdAt'])
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.customerUid is string
    && request.resource.data.customerName is string
    && request.resource.data.status == 'active'
    && request.resource.data.createdAt == request.time
    && existsAfter(/databases/$(database)/documents/connectionRequests/$(request.resource.data.requestId))
    && getAfter(/databases/$(database)/documents/connectionRequests/$(request.resource.data.requestId)).data.status == 'accepted'
    && getAfter(/databases/$(database)/documents/connectionRequests/$(request.resource.data.requestId)).data.targetUid == request.auth.uid
    && getAfter(/databases/$(database)/documents/connectionRequests/$(request.resource.data.requestId)).data.requesterUid == request.resource.data.customerUid;
   allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.customerUid == request.auth.uid);
   allow update, delete: if false;
  }

  match /dairyEntries/{entryId} {
   allow create: if ownerProfile()
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.customerUid is string
    && exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + request.resource.data.customerUid))
    && request.resource.data.kg is number
    && request.resource.data.kg > 0
    && request.resource.data.sample is number
    && request.resource.data.rate is number
    && request.resource.data.total is number
    && request.resource.data.date is string
    && request.resource.data.shift in ['Morning','Evening','सुबह','शाम']
    && request.resource.data.entryId is string
    && request.resource.data.createdAt == request.time;
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/dairyEntries/$(entryId)) || resource.data.ownerUid == request.auth.uid || resource.data.customerUid == request.auth.uid);
   allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.customerUid == request.auth.uid);
   allow update, delete: if false;
  }

  match /dairyAdjustments/{adjustmentId} {
   allow create: if ownerProfile()
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.customerUid is string
    && exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + request.resource.data.customerUid))
    && request.resource.data.kind in ['amount','kg']
    && request.resource.data.delta is number
    && request.resource.data.delta != 0
    && request.resource.data.note is string
    && request.resource.data.date is string
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.customerUid == request.auth.uid);
   allow update, delete: if false;
  }

  match /dairyPayments/{paymentId} {
   allow create: if ownerProfile()
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.customerUid is string
    && exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + request.resource.data.customerUid))
    && request.resource.data.amount is number
    && request.resource.data.amount > 0
    && request.resource.data.date is string
    && request.resource.data.status == 'saved'
    && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.customerUid == request.auth.uid);
   allow update, delete: if false;
  }
 }
}
